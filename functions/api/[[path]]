// functions/api/[[path]].js
// 逃离锈钴城 - Pages Functions API
// 处理所有 /api/* 请求

// 辅助函数：生成JSON响应
function createResponse(data, status = 200) {
    return new Response(JSON.stringify(data), {
        status,
        headers: {
            'Content-Type': 'application/json',
            'Access-Control-Allow-Origin': '*', // 允许所有来源，根据需求可调整
            'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
        }
    });
}

// 辅助函数：错误响应
function createErrorResponse(message, status = 400) {
    return createResponse({ error: true, message }, status);
}

// 计算玩家总属性
function calculateTotalAttributes(attributes) {
    if (!attributes) return 0;
    return Object.values(attributes).reduce((sum, val) => sum + (parseInt(val) || 0), 0);
}

// 1. 保存玩家数据 (POST /api/save)
async function handleSavePlayer(request, env) {
    try {
        const data = await request.json();
        const { playerId, playerData } = data;

        if (!playerId || !playerData) {
            return createErrorResponse('缺少 playerId 或 playerData');
        }

        // 更新元数据
        playerData.lastActive = new Date().toISOString();
        playerData.updatedAt = playerData.lastActive;

        if (playerData.attributes) {
            playerData.totalAttributes = calculateTotalAttributes(playerData.attributes);
        }

        // 保存到 KV
        await env.PLAYERS.put(playerId, JSON.stringify(playerData));

        // 更新实时排行榜
        if (playerData.isGameActive !== false && playerData.buildProgress < 100) {
            const rankingEntry = {
                playerId,
                playerCode: playerData.player?.code || '未知',
                profession: playerData.player?.profession || 'unknown',
                totalAttributes: playerData.totalAttributes || 0,
                buildProgress: playerData.buildProgress || 0,
                gold: playerData.gold || 0,
                currentDay: playerData.currentDay || 1,
                lastActive: playerData.lastActive
            };

            let rankings = JSON.parse(await env.RANKINGS.get('live_rankings') || '[]');
            const existingIndex = rankings.findIndex(item => item.playerId === playerId);
            if (existingIndex >= 0) {
                rankings[existingIndex] = rankingEntry;
            } else {
                rankings.push(rankingEntry);
            }
            rankings.sort((a, b) => b.totalAttributes - a.totalAttributes);
            rankings = rankings.slice(0, 100); // 保持前100名
            await env.RANKINGS.put('live_rankings', JSON.stringify(rankings));
        }

        return createResponse({
            success: true,
            message: '玩家数据保存成功',
            playerId,
            timestamp: playerData.updatedAt
        });

    } catch (error) {
        console.error('保存玩家数据失败:', error);
        return createErrorResponse('保存失败: ' + error.message, 500);
    }
}

// 2. 加载玩家数据 (GET /api/load?playerId=xxx)
async function handleLoadPlayer(request, env) {
    try {
        const url = new URL(request.url);
        const playerId = url.searchParams.get('playerId');

        if (!playerId) {
            return createErrorResponse('缺少 playerId');
        }

        const playerData = await env.PLAYERS.get(playerId, 'json');

        if (!playerData) {
            return createErrorResponse('玩家数据不存在', 404);
        }

        return createResponse({
            success: true,
            playerData
        });

    } catch (error) {
        console.error('加载玩家数据失败:', error);
        return createErrorResponse('加载失败: ' + error.message, 500);
    }
}

// 3. 获取实时排行榜 (GET /api/rankings)
async function handleGetRankings(request, env) {
    try {
        const url = new URL(request.url);
        const limit = parseInt(url.searchParams.get('limit')) || 10;

        let rankings = JSON.parse(await env.RANKINGS.get('live_rankings') || '[]');

        // 按总属性排序并限制数量
        rankings.sort((a, b) => b.totalAttributes - a.totalAttributes);
        const result = rankings.slice(0, limit).map((player, index) => ({
            ...player,
            position: index + 1
        }));

        return createResponse({
            success: true,
            rankings: result,
            total: rankings.length
        });

    } catch (error) {
        console.error('获取排行榜失败:', error);
        return createErrorResponse('获取排行榜失败', 500);
    }
}

// 4. 获取荣誉榜 (GET /api/honor)
async function handleGetHonor(request, env) {
    try {
        const url = new URL(request.url);
        const limit = parseInt(url.searchParams.get('limit')) || 10;

        let honorList = JSON.parse(await env.HONOR.get('honor_list') || '[]');

        // 按逃脱日期倒序排列
        honorList.sort((a, b) => new Date(b.escapeDate) - new Date(a.escapeDate));
        const result = honorList.slice(0, limit);

        return createResponse({
            success: true,
            honorList: result,
            total: honorList.length
        });

    } catch (error) {
        console.error('获取荣誉榜失败:', error);
        return createErrorResponse('获取荣誉榜失败', 500);
    }
}

// 5. 提交到荣誉榜 (POST /api/honor/submit)
async function handleSubmitToHonor(request, env) {
    try {
        const data = await request.json();
        const { playerId, playerData } = data;

        if (!playerId || !playerData) {
            return createErrorResponse('缺少 playerId 或 playerData');
        }

        if (playerData.buildProgress < 100) {
            return createErrorResponse('建造进度未达到100%，无法进入荣誉榜');
        }

        // 创建荣誉记录
        const honorRecord = {
            playerId,
            playerCode: playerData.player?.code || '未知',
            profession: playerData.player?.profession || 'unknown',
            escapeDate: new Date().toISOString(),
            daysUsed: playerData.currentDay || 30,
            buildProgress: playerData.buildProgress,
            totalAttributes: playerData.totalAttributes || 0,
            finalGold: playerData.gold || 0
        };

        // 获取并更新荣誉榜
        let honorList = JSON.parse(await env.HONOR.get('honor_list') || '[]');

        // 防止重复提交
        const exists = honorList.some(record => record.playerId === playerId);
        if (!exists) {
            honorList.push(honorRecord);
            // 保持荣誉榜大小
            if (honorList.length > 50) {
                honorList.sort((a, b) => new Date(b.escapeDate) - new Date(a.escapeDate));
                honorList = honorList.slice(0, 50);
            }
            await env.HONOR.put('honor_list', JSON.stringify(honorList));
        }

        // 从实时排行榜中移除
        let rankings = JSON.parse(await env.RANKINGS.get('live_rankings') || '[]');
        rankings = rankings.filter(player => player.playerId !== playerId);
        await env.RANKINGS.put('live_rankings', JSON.stringify(rankings));

        return createResponse({
            success: true,
            message: '成功添加到荣誉榜',
            honorRecord
        });

    } catch (error) {
        console.error('提交到荣誉榜失败:', error);
        return createErrorResponse('提交失败', 500);
    }
}

// 6. 清理过期数据 (POST /api/internal/cleanup) - 由Cron Worker调用
async function handleCleanup(request, env) {
    try {
        const thirtyDaysAgo = new Date(Date.now() - 30 * 24 * 60 * 60 * 1000).toISOString();
        const { keys } = await env.PLAYERS.list();

        let deletedCount = 0;
        for (const key of keys) {
            const playerData = await env.PLAYERS.get(key.name, 'json');
            if (playerData && playerData.lastActive && playerData.lastActive < thirtyDaysAgo) {
                await env.PLAYERS.delete(key.name);
                deletedCount++;
            }
        }

        return createResponse({
            success: true,
            message: `数据清理完成，删除了 ${deletedCount} 条过期记录`,
            timestamp: new Date().toISOString()
        });

    } catch (error) {
        console.error('清理数据失败:', error);
        return createErrorResponse('清理失败', 500);
    }
}

// 主请求处理函数
export async function onRequest(context) {
    const { request, env } = context; // env 包含已绑定的 KV 命名空间
    const url = new URL(request.url);
    const pathname = url.pathname;

    // 路由定义
    const route = pathname.replace('/api/', '');

    // 处理预检请求
    if (request.method === 'OPTIONS') {
        return new Response(null, {
            headers: {
                'Access-Control-Allow-Origin': '*',
                'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
                'Access-Control-Allow-Headers': 'Content-Type',
            }
        });
    }

    try {
        // 路由分发
        switch (route) {
            case 'save':
                if (request.method !== 'POST') return createErrorResponse('方法不允许', 405);
                return await handleSavePlayer(request, env);
            case 'load':
                if (request.method !== 'GET') return createErrorResponse('方法不允许', 405);
                return await handleLoadPlayer(request, env);
            case 'rankings':
                if (request.method !== 'GET') return createErrorResponse('方法不允许', 405);
                return await handleGetRankings(request, env);
            case 'honor':
                if (request.method !== 'GET') return createErrorResponse('方法不允许', 405);
                return await handleGetHonor(request, env);
            case 'honor/submit':
                if (request.method !== 'POST') return createErrorResponse('方法不允许', 405);
                return await handleSubmitToHonor(request, env);
            case 'internal/cleanup':
                // 可选：在此处添加一个简单的密钥验证，防止公开调用
                // const authHeader = request.headers.get('Authorization');
                // if (authHeader !== 'Bearer your-secret-token') {
                //     return createErrorResponse('未授权', 401);
                // }
                if (request.method !== 'POST') return createErrorResponse('方法不允许', 405);
                return await handleCleanup(request, env);
            default:
                return createErrorResponse('API路径未找到: ' + route, 404);
        }
    } catch (error) {
        console.error('API处理异常:', error);
        return createErrorResponse('服务器内部错误: ' + error.message, 500);
    }
}
